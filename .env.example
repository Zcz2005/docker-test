# Southnotary API
SOUTHNOTARY_DOMAIN_ID=southnotary
SOUTHNOTARY_BASE_URL=https://www.southnotary.cn/api
SOUTHNOTARY_API_HOST=www.southnotary.cn
SOUTHNOTARY_APPID=replace-with-appid
SOUTHNOTARY_RANDKEY=replace-with-randkey
SOUTHNOTARY_HASHVAL=replace-with-hashval

# CTYun OOS / ZOS
OOS_ACCESS_KEY=replace-with-access-key
OOS_SECRET_KEY=replace-with-secret-key
OOS_ENDPOINT=https://huanan2.zos.ctyun.cn
OOS_BUCKET=bucket-azy-southnotary
OOS_SIGNATURE_VERSION=s3
OOS_SERVICE_NAME=s3
OOS_API_VERSION=2006-03-01

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-user
MYSQL_PASSWORD=replace-with-password
MYSQL_DATABASE=replace-with-database
MYSQL_CHARSET=utf8mb4

# Runtime
EVIDENCE_FETCH_INTERVAL_SECONDS=10
UPLOAD_INTERVAL_SECONDS=10
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# LOG_DIR=/absolute/path/to/logs
