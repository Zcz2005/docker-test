# Domain configuration
DOMAIN_ID=southnotary
BASE_URL=https://www.southnotary.cn/api
API_HOST=www.southnotary.cn

# Evidence API credentials
EVIDENCE_APPID=your_appid
EVIDENCE_RANDKEY=your_randkey
EVIDENCE_HASHVAL=your_hashval

# OOS / ZOS object storage
OOS_ACCESS_KEY=your_access_key
OOS_SECRET_KEY=your_secret_key
OOS_ENDPOINT=https://huanan2.zos.ctyun.cn
OOS_BUCKET=bucket-azy-southnotary

# MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=evidence_db

# Scheduler intervals (seconds)
EVIDENCE_POLL_INTERVAL=10
UPLOAD_POLL_INTERVAL=10

# Logging
LOG_LEVEL=INFO
